# Copy to .env and fill in from Supabase Dashboard → Project Settings → API.
# On Vercel, set these under Project Settings → Environment Variables instead.

# --- Client bundle (VITE_* is inlined at build time and IS visible in the browser) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=<project-ref>

# --- SSR / server runtime (same values as above, read via process.env) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=<project-ref>

# --- Server only. Bypasses RLS — never prefix with VITE_, never commit. ---
# Used by src/integrations/supabase/client.server.ts for admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# --- Xendit disbursement key, server only (src/lib/payout.functions.ts). ---
# Leave empty to keep withdrawals on manual transfer.
PAYOUT_API_KEY=
